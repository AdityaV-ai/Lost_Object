# Copy to .env and edit. Never commit .env.
# Required for stable logins across restarts. If empty, a random key is generated
# at startup (all tokens become invalid on every restart).
SECRET_KEY=
# Default: the legacy SQLite file at backend/instance/lost_object_recovery.db
# DATABASE_URL=sqlite:///E:/path/to/db.sqlite
# UPLOAD_DIR=E:/path/to/uploads
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true/false: run live OpenCLIP image matching (needs torch + open_clip + model weights)
IMAGE_MATCHING_ENABLED=true
# Candidates below these relevance scores are not stored or notified.
# Defaults come from scripts/evaluate_weights.py on the sample dataset.
MATCH_MIN_SCORE_IMAGE=0.50
MATCH_MIN_SCORE_NO_IMAGE=0.25
